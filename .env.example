NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only use the service role key in server-only scripts or secure backend routes.
# Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional shared secret for inbound email provider webhooks.
INBOUND_MAILHOOK_SECRET=choose-a-long-random-secret

# Used for OAuth redirects, connected mailbox sending, and hosted email assets.
# In Vercel this must be your public site URL, not localhost/127.0.0.1.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
CONNECTED_ACCOUNT_ENCRYPTION_KEY=choose-a-long-random-secret
OAUTH_STATE_SECRET=choose-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-oauth-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-oauth-client-secret

# Used by the email builder AI chat. Keep this server-side only.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
